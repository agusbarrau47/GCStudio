# =========================================================================
# GCStudio · Variables de entorno
# Copiá este archivo a .env.local y completá los valores. Ver SETUP.md.
# SIN estas variables la app corre en MODO DESARROLLO (mock) para poder verla.
# En producción, el modo mock NO concede acceso a contenido premium.
# =========================================================================

# URL pública de la app (sin barra final). En Vercel: https://tudominio.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --------------------------------------------------------------- SUPABASE
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETO — solo server-side (webhooks, tareas admin). NUNCA con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- PAGOS
# mock | mercadopago | stripe
PAYMENT_PROVIDER=mock
# Mercado Pago → Tus integraciones → Credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=
# Secreto opcional para validar el webhook (se compara con ?secret= en la notification_url)
MERCADOPAGO_WEBHOOK_SECRET=

# ---------------------------------------------------------------- VIDEO
# mock | cloudflare | mux
VIDEO_PROVIDER=mock
# Cloudflare → Stream
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Para firmar signed URLs (Stream → Keys). El JWK va en base64.
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_KEY_JWK=

# ----------------------------------------------------- GOOGLE OAUTH (opcional)
# Se configura en el panel de Supabase (Auth → Providers → Google).
# Estas variables son solo de referencia para el registro en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
